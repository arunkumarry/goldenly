<% content_for :title, "Emergency SOS · Goldenly" %>
<main class="dashboard"><%= render "shared/sidebar" %><section class="content"><div class="workflow-page"><%= link_to "← Back to hospitals", nearby_hospitals_path, class: "back-link" %><section class="workflow-card emergency-confirmation-card"><p class="eyebrow">EMERGENCY SOS</p><h1>Confirm emergency alert</h1><p>This sends a Goldenly push and SMS alert to available trusted contacts after you confirm. Goldenly never calls emergency services automatically.</p><div class="emergency-number-card"><strong>For immediate danger</strong><span>Call <%= @emergency_number %></span><%= link_to "Call #{@emergency_number} now", "tel:#{@emergency_number}", class: "primary-button", data: { turbo: false } %></div><%= form_with url: emergency_alert_path, method: :post, class: "workflow-form" do %><label class="checkbox-label"><%= check_box_tag :share_location, "1", false %><span>Share <%= @care_profile.full_name %>'s saved location with trusted contacts in this SOS alert.</span></label><p class="hospital-disclaimer">Only continue if you want Goldenly to notify your trusted contacts now.</p><div class="form-actions-right"><%= submit_tag "Confirm SOS alert", class: "primary-button" %></div><% end %></section></div></section></main>
